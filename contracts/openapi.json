                }
              }
            }
          }
        }
      }
    },
    "/decisions/{decision_id}/stress": {
      "post": {
        "summary": "Stress Decision",
        "description": "Re-runs the Monte Carlo simulation for every fork of a decision with extra shocks\n(late inflows, a surprise bill, higher spending, a different floor). Takes a few ms,\nso the UI can call it as sliders move.",
        "operationId": "stress_decision_decisions__decision_id__stress_post",
        "parameters": [
          {
            "name": "decision_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Decision Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StressRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StressResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/me/decisions": {
      "get": {
        "summary": "My Decisions",
        "description": "The signed-in user's decisions, newest first.",
        "operationId": "my_decisions_me_decisions_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 100,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HistoryResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/scenarios/{parent_scenario_id}/branch": {
      "post": {
        "summary": "Branch Scenario Endpoint",
        "operationId": "branch_scenario_endpoint_scenarios__parent_scenario_id__branch_post",
        "parameters": [
          {
            "name": "parent_scenario_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Parent Scenario Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BranchScenarioRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Scenario"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AuthConfig": {
        "properties": {
          "google_client_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Google Client Id",
            "description": "OAuth client ID for Google Identity Services"
          },
          "dev_login": {
            "type": "boolean",
            "title": "Dev Login",
            "description": "True when POST /auth/dev-login is enabled (development only)",
            "default": false
          }
        },
        "type": "object",
        "title": "AuthConfig"
      },
      "Body_inspect_dataset_datasets_inspect_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "description": "Financial CSV file (bank/UPI/ERP/P&L)"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_inspect_dataset_datasets_inspect_post"
      },
      "BranchScenarioRequest": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "description": "Name for the new child scenario"
          },
          "change": {
            "additionalProperties": true,
            "type": "object",
            "title": "Change",
            "description": "ChangeSpec: {type: upfront|emi|phased|trim, params: {...overrides}}"
          }
        },
        "type": "object",
        "required": [
          "name",
          "change"
        ],
        "title": "BranchScenarioRequest"
      },
      "CashFlowCategory": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "type": {
            "type": "string",
            "enum": [
              "fixed",
              "flexible"
            ],
            "title": "Type"
          },
          "values": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Values",
            "description": "Outflow per month (\u20b9), after any trims"
          }
        },
        "type": "object",
        "required": [
          "name",
          "type",
          "values"
        ],
        "title": "CashFlowCategory"
      },
      "CashFlowMatrix": {
        "properties": {
          "months": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Months"
          },
          "projected": {
            "items": {
              "type": "boolean"
            },
            "type": "array",
            "title": "Projected",
            "description": "True for months projected from averages"
          },
          "inflows": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Inflows"
          },
          "purchase_cash_out": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Purchase Cash Out"
          },
          "categories": {
            "items": {
              "$ref": "#/components/schemas/CashFlowCategory"
            },
            "type": "array",
            "title": "Categories"
          }
        },
        "type": "object",
        "required": [
          "months",
          "inflows",
          "purchase_cash_out",
          "categories"
        ],
        "title": "CashFlowMatrix"
      },
      "ChangeSpec": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type",
            "description": "baseline, or a fork type: upfront | emi | phased | trim | absorb | delay | phase_in"
          },
          "params": {
            "additionalProperties": true,
            "type": "object",
            "title": "Params",
            "description": "PurchaseGoal fields"
          }
        },
        "type": "object",
        "required": [
          "type"
        ],
        "title": "ChangeSpec"
      },
      "CommitRequest": {
        "properties": {
          "upload_id": {
            "type": "string",
            "title": "Upload Id",
            "description": "upload_id returned by /datasets/inspect"
          },
          "confirmed_mapping": {
            "additionalProperties": true,
            "type": "object",
            "title": "Confirmed Mapping",
            "description": "Confirmed ColumnMapping (from the inspect response, optionally edited)"
          },
          "dataset_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dataset Name",
            "description": "Human-friendly name for the dataset"
          },
          "starting_balance": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Starting Balance",
            "description": "Opening cash balance (\u20b9). Overrides any balance inferred from the CSV."
          },
          "dataset_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dataset Type",
            "description": "personal | institute | startup (defaults to the type detected at inspect)"
          },
          "monthly_income": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Monthly Income",
            "description": "Monthly income (\u20b9). Use when the file has no income rows, e.g. an expenses-only export."
          }
        },
        "type": "object",
        "required": [
          "upload_id",
          "confirmed_mapping"
        ],
        "title": "CommitRequest"
      },
      "ComparisonResponse": {
        "properties": {
          "decision_id": {
            "type": "string",
            "title": "Decision Id"
          },
          "decision_spec": {
            "additionalProperties": true,
            "type": "object",
            "title": "Decision Spec"
          },
          "scenarios": {
            "items": {
              "$ref": "#/components/schemas/Scenario"
            },
            "type": "array",
            "title": "Scenarios"
          },
          "results": {
            "additionalProperties": {
              "$ref": "#/components/schemas/FinancialScenarioResult"
            },
            "type": "object",
            "title": "Results"
          },
          "explanation": {
            "$ref": "#/components/schemas/Explanation"
          }
        },
        "type": "object",
        "required": [
          "decision_id",
          "decision_spec",
          "scenarios",
          "results",
          "explanation"
        ],
        "title": "ComparisonResponse"
      },
      "CreateDecisionRequest": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text",
            "description": "Plain-English financial decision prompt"
          },
          "dataset_id": {
            "type": "string",
            "title": "Dataset Id",
            "description": "Dataset id (from /datasets or /datasets/commit)"
          }
        },
        "type": "object",
        "required": [
          "text",
          "dataset_id"
        ],
        "title": "CreateDecisionRequest"
      },
      "DevLoginRequest": {
        "properties": {
          "email": {
            "type": "string",
            "title": "Email",
            "description": "Any address; one local user per address",
            "default": "dev@futurefork.local"
          },
          "name": {
            "type": "string",
            "title": "Name",
            "default": "Local Developer"
          }
        },
        "type": "object",
        "title": "DevLoginRequest"
      },
      "Explanation": {
        "properties": {
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "source": {
            "type": "string",
            "title": "Source",
            "description": "llm | template | none"
          },
          "guard_passed": {
            "type": "boolean",
            "title": "Guard Passed",
            "description": "True if every number passed the Numeric Guard"
          },
          "violations": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Violations"
          }
        },
        "type": "object",
        "required": [
          "summary",
          "source",
          "guard_passed"
        ],
        "title": "Explanation"
      },
      "FinancialMetrics": {
        "properties": {
          "cash_out_risk_pct": {
            "type": "number",
            "title": "Cash Out Risk Pct",
            "description": "% of Monte Carlo runs that go below \u20b90"
          },
          "floor_breach_risk_pct": {
            "type": "number",
            "title": "Floor Breach Risk Pct",
