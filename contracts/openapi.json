              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/datasets/commit": {
      "post": {
        "summary": "Commit Dataset",
        "description": "Compiles the uploaded CSV into a 12-month baseline (Node 0) and saves it as a dataset.",
        "operationId": "commit_dataset_datasets_commit_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CommitRequest"
