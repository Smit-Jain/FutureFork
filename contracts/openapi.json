        }
      }
    },
    "/decisions/{decision_id}/compare": {
      "get": {
        "summary": "Get Decision Comparison",
        "operationId": "get_decision_comparison_decisions__decision_id__compare_get",
        "parameters": [
          {
            "name": "decision_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Decision Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ComparisonResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
