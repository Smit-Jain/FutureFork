# FutureFork backend configuration (copy to .env; loaded automatically on startup)

# --- Application ---
# "production" hides exception details in API error responses
ENVIRONMENT=development
PORT=8000
# Comma-separated frontend origins allowed by CORS ("*" allows any origin, without credentials)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database: SQLite locally, or a Postgres connection string (e.g. Supabase) ---
DATABASE_URL=sqlite:///./futurefork.db
# PostgreSQL example (local): postgresql+psycopg2://<user>:<password>@localhost:5432/<database>
# The schema is managed by Alembic and applied automatically on startup (or: alembic upgrade head).

# --- Authentication (Google Sign-In) ---
# OAuth client ID ("Web application") from Google Cloud Console → APIs & Services → Credentials.
# Authorized JavaScript origins: http://localhost:5173 (plus your production frontend). No secret needed.
GOOGLE_CLIENT_ID=
# Signs the session cookie. Required in production; generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# SESSION_TTL_DAYS=7
# Frontend and API on different domains in production? Use COOKIE_SAMESITE=none with COOKIE_SECURE=1
# COOKIE_SAMESITE=lax
# COOKIE_SECURE=0
# Development only: adds "Continue as local developer" on the sign-in page (ignored in production)
AUTH_DEV_LOGIN=1

# --- AI layer (optional) ---
# Without a key, every agent uses its deterministic regex/template fallback.
OPENAI_API_KEY=
# GROQ_API_KEY=
# Set to 1 to force offline mode even when a key is set
# FUTUREFORK_OFFLINE=1

# --- Engine ---
NUM_SIMULATION_RUNS=300
RANDOM_SEED=42
CACHE_ENABLED=true
