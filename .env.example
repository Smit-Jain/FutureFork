# FutureFork Environment Configuration

# Application Environment
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://futurefork.vercel.app

# Database
# Use SQLite for local development or Postgres connection string (e.g. Supabase)
DATABASE_URL=sqlite:///./futurefork.db
# SUPABASE_URL=https://xyzcompany.supabase.co
# SUPABASE_KEY=ey...

# AI Layer
LLM_PROVIDER=openai
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=

# Engine Settings
SOLVER_TIME_LIMIT_SECONDS=8
NUM_SIMULATION_RUNS=300
RANDOM_SEED=42
CACHE_ENABLED=true
